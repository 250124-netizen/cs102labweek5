#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    int b = 0, a = 0, l = 0, o = 0, nvalue = 0;
    int i = 0;

    while (i < n) {
        char c;
        cin >> c;

        switch (c) {
            case 'b': b++; break;
            case 'a': a++; break;
            case 'l': l++; break;
            case 'o': o++; break;
            case 'n': nvalue++; break;
            default: break;
        }
        i++;
    }

     int ans = b;
    if (a < ans) ans = a;
    if (l / 2 < ans) ans = l / 2;
    if (o / 2 < ans) ans = o / 2;
    if (nvalue < ans) ans = nvalue;

    cout << ans << endl;
    return 0;
}
